# Copy this file to config/server.env on your server, then: chmod 600 config/server.env
# Avoid committing real credentials to Git. Accounts are created at /register.
DB_URL=jdbc:postgresql://pg:5432/studs
DB_USER=YOUR_STUDENT_LOGIN
DB_PASSWORD='REPLACE_WITH_DB_PASSWORD'
# Existing schema to which this account has USAGE and CREATE privileges.
DB_SCHEMA=YOUR_EXISTING_SCHEMA
PORT=8080
BIND_ADDRESS=127.0.0.1
JAVA_OPTS='-Xms64m -Xmx512m'
